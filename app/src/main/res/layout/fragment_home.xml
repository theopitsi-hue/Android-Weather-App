<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@drawable/main_bg"
    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"

            android:paddingHorizontal="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="left"
                    android:fontFamily="@font/amiko"
                    android:text="Weather View"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/changeLocation"
                        android:layout_width="36dp"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="Change location"
                        android:scaleType="centerInside"
                        android:src="@android:drawable/ic_menu_mylocation" />

                    <TextView
                        android:id="@+id/placeFancyText"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/amiko"
                        android:gravity="bottom"
                        android:text="place, town"
                        android:textAlignment="textStart"
                        android:textSize="18sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="172dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="157dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingTop="20dp"
                            android:paddingBottom="6dp">

                            <TextView
                                android:id="@+id/temperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:fontFamily="@font/amiko"
                                android:text="32"
                                android:textSize="48sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tempUnit"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_marginBottom="6dp"
                                android:fontFamily="@font/amiko"
                                android:gravity="top"
                                android:text="C"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tempFeelsLike"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/amiko"
                            android:text="Feels like X"
                            android:textColor="#B2B2D1"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/rainChance"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/amiko"

                            android:text="rainChance"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/humidity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/amiko"

                            android:text="humidity"
                            android:textSize="16sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/weatherImage"
                            android:layout_width="match_parent"
                            android:layout_height="101dp"
                            android:layout_gravity="top"
                            android:src="@android:drawable/btn_star_big_off" />

                        <TextView
                            android:id="@+id/weatherSituation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/amiko"
                            android:text="weatherSituation"

                            android:textAlignment="textEnd"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/dayData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"

                            android:fontFamily="@font/amiko"
                            android:text="day data"

                            android:textAlignment="textEnd"
                            android:textSize="16sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:background="@drawable/gradient_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textView8"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="left"
                    android:fontFamily="@font/amiko"
                    android:text="This Week"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <include
                            android:id="@+id/day1"
                            layout="@layout/view_forecast_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp" />

                        <include
                            android:id="@+id/day2"
                            layout="@layout/view_forecast_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp" />

                        <include
                            android:id="@+id/day3"
                            layout="@layout/view_forecast_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp" />

                        <include
                            android:id="@+id/day4"
                            layout="@layout/view_forecast_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp" />

                        <include
                            android:id="@+id/day5"
                            layout="@layout/view_forecast_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp" />

                        <include
                            android:id="@+id/day6"
                            layout="@layout/view_forecast_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp" />

                        <include
                            android:id="@+id/day7"
                            layout="@layout/view_forecast_day"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="2dp" />
                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:background="@drawable/gradient_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="left"
                    android:fontFamily="@font/amiko"
                    android:text="Location"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="left"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="@font/amiko"
                    android:text="@string/location_input_prompt"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/etLocation"
                    android:layout_width="match_parent"
                    android:layout_height="59dp"
                    android:layout_marginBottom="3dp"
                    android:fontFamily="@font/amiko"
                    android:hint="@string/e_g_athens_greece"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:shadowColor="#FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#B2B2D1"
                    android:textColorLink="#FFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="59dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_marginVertical="0dp"
                        android:fontFamily="@font/amiko"
                        android:paddingVertical="0dp"
                        android:text="@string/search"
                        app:cornerRadius="30dp" />

                    <Button
                        android:id="@+id/btnGps"
                        android:layout_width="wrap_content"
                        android:layout_height="59dp"
                        android:layout_marginHorizontal="2dp"
                        android:layout_marginVertical="0dp"
                        android:contentDescription="@string/detect_my_location"
                        android:fontFamily="@font/amiko"
                        android:paddingVertical="0dp"
                        android:text="@string/detect_my_location"
                        app:cornerRadius="30dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/amiko"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:text="debug view output"
                    android:textSize="16sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>